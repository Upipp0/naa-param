#!/bin/bash
# =============================================================================
# {{ sched.label }} batch script — atom rename, residue {{ job_name }}
# Generated by `naa-param setup` (cluster profile: {{ profile.name }})
# =============================================================================

{% include sched.directives %}
{% if sched.workdir %}

# --- Start in the directory the job was submitted from -----------------------
{{ sched.workdir }}
{% endif %}

# --- Environment setup (cluster profile: {{ profile.name }}) -----------------
{{ profile.env_setup }}
echo "=================================================================="
echo " rename — residue {{ job_name }} — profile {{ profile.name }}"
echo " Job : {{ sched.job_id }} on $(hostname) — started $(date)"
echo "=================================================================="

naa-param fixpdb \
    --resname "{{ resname }}" \
    --rtp     "{{ rtp_file }}" \
    --target  "{{ target_pdb }}" \
    --out     "{{ out_pdb }}"
EXIT_CODE=$?

echo " Finished $(date)   exit=$EXIT_CODE"
exit $EXIT_CODE
