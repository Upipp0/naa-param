#!/bin/bash
# =============================================================================
# {{ sched.label }} batch script — naa_param {{ description }}, residue {{ job_name }}
# Generated by `naa-param setup` (cluster profile: {{ profile.name }})
# Submit via: {{ sched.submit }} {{ script_name }}   (or use submit_pipeline.sh)
# =============================================================================

{% include sched.directives %}
{% if sched.workdir %}

# --- Start in the directory the job was submitted from -----------------------
{{ sched.workdir }}
{% endif %}

# --- Environment setup (cluster profile: {{ profile.name }}) -----------------
{{ profile.env_setup }}
# --- Resources this job requested (read back by naa-param) -------------------
# Stated here rather than read from the scheduler: Slurm publishes the
# allocation in its own variables but PBS publishes no memory limit at all, so
# the script that wrote the directives above is the one that knows. See
# external.qm_resources().
export NAA_PARAM_NPROC={{ req.cpus }}
export NAA_PARAM_MEM_MB={{ req.mem_mb }}

# --- Gaussian scratch directory (per-job, auto-cleaned) -----------------------
export GAUSS_SCRDIR="{{ profile.scratch_base }}/g16_{{ sched.job_id_or_pid }}"
mkdir -p "$GAUSS_SCRDIR"
trap 'rm -rf "$GAUSS_SCRDIR"' EXIT INT TERM

# --- Run the pipeline --------------------------------------------------------
CONFIG="{{ config_path }}"
echo "=================================================================="
echo " naa_param — residue {{ job_name }} — {{ description }}"
echo " Profile: {{ profile.name }}"
echo " Config : $CONFIG"
echo " Job    : {{ sched.job_id }} on $(hostname) — started $(date)"
echo "=================================================================="

naa-param run --config "$CONFIG"{% if step_args %} {{ step_args }}{% endif %}

EXIT_CODE=$?

echo " Finished $(date)   exit=$EXIT_CODE"
exit $EXIT_CODE
