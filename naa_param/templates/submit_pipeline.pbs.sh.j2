#!/bin/bash
# =============================================================================
# submit_pipeline.sh — {{ mode }} submission (PBS)
# Generated by `naa-param setup`
#
{% if mode == "scatter" %}
# Scatter/gather: every residue's QM work (steps 1-7: cap, Gaussian opt, ESP,
# RESP, merge, acpype) is independent, so those jobs are submitted together and
# run in parallel. The assembly job then integrates the residues into the force
# field in order (steps 8-9), and starts only once *all* QM jobs have succeeded
# (-W depend=afterok on every one of them).
{% else %}
# Chained: one job per residue, each running the full pipeline and starting only
# after the previous one succeeded (-W depend=afterok).
{% endif %}
#
# Usage: bash pbs_scripts/submit_pipeline.sh
# If a job fails, the jobs depending on it never become eligible: they sit held
# (state H) and `qstat -f <id>` reports the unsatisfied dependency. Delete them
# with qdel, fix the cause, and resubmit (completed steps are skipped
# automatically).
# =============================================================================

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

submitted_ids=""

fail() {
    echo "" >&2
    echo "ERROR: $1" >&2
    if [ -n "$submitted_ids" ]; then
        echo "Jobs already queued: $submitted_ids" >&2
        echo "Cancel them with:    qdel $submitted_ids" >&2
    fi
    exit 1
}

# submit <script> [qsub args...] — sets JOB_ID, or aborts.
#
# There is no --parsable: qsub prints the job id on stdout and that is the whole
# interface. Keep the string exactly as printed — a PBS id is `1234.pbs-server`
# and `-W depend=` wants all of it, not the leading integer.
#
# `pipefail` at the top is load-bearing: without it `tail` would exit 0 and a
# failed qsub would read as a successful submission with an empty job id.
submit() {
    local script="$1"
    shift
    [ -f "$SCRIPT_DIR/$script" ] || fail "job script not found: $SCRIPT_DIR/$script"
    JOB_ID=$(qsub "$@" "$SCRIPT_DIR/$script" | tail -n 1 | tr -d '[:space:]') \
        || fail "qsub failed for $script"
    [ -n "$JOB_ID" ] || fail "qsub returned no job id for $script"
    submitted_ids="${submitted_ids:+$submitted_ids }$JOB_ID"
}

{% if mode == "scatter" %}
{% if scatter %}
echo "Submitting {{ scatter|length }} QM job(s) — these run in parallel ..."
QM_DEPS=""
{% for job in scatter %}
submit "{{ job.script }}"
QM_DEPS="${QM_DEPS}:${JOB_ID}"
echo "  [{{ loop.index }}/{{ scatter|length }}] QM {{ job.label }} -> job ${JOB_ID}"
{% endfor %}

echo "Submitting the assembly job (waits for all QM jobs) ..."
submit "{{ assemble_script }}" -W depend="afterok${QM_DEPS}"
echo "  assembly -> job ${JOB_ID}"
{% else %}
echo "No QM jobs to run — submitting the assembly job directly ..."
submit "{{ assemble_script }}"
echo "  assembly -> job ${JOB_ID}"
{% endif %}
{% else %}
echo "Submitting {{ chain|length }}-job chained pipeline ..."
PREV=""
{% for job in chain %}
{% if loop.first %}
submit "{{ job.script }}"
echo "  [{{ loop.index }}/{{ chain|length }}] {{ job.label }} -> job ${JOB_ID}"
{% else %}
submit "{{ job.script }}" -W depend="afterok:${PREV}"
echo "  [{{ loop.index }}/{{ chain|length }}] {{ job.label }} -> job ${JOB_ID} (after ${PREV})"
{% endif %}
PREV="$JOB_ID"
{% endfor %}
{% endif %}

echo ""
echo "All jobs queued: $submitted_ids"
echo "Monitor with:    qstat -u $USER"
echo "Finished jobs:   qstat -x -u $USER    (only if the site enabled job history;"
echo "                                       plain qstat forgets a job immediately)"
echo "Cancel all with: qdel $submitted_ids"
