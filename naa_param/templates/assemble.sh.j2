#!/bin/bash
# =============================================================================
# {{ sched.label }} batch script — naa_param assembly (gather phase)
# Generated by `naa-param setup` (cluster profile: {{ profile.name }})
#
# Runs once every QM job has completed successfully. The tasks below are
# sequential by nature and must stay in this order:
#   * each rename edits the protein PDB that later tasks read;
#   * each residue's force-field integration extends the force field the
#     previous residue produced, and updates the shared residuetypes.dat.
# No Gaussian or AmberTools work happens here — it is pure Python.
# =============================================================================

{% include sched.directives %}
{% if sched.workdir %}

# --- Start in the directory the job was submitted from -----------------------
{{ sched.workdir }}
{% endif %}

# --- Environment setup (cluster profile: {{ profile.name }}) -----------------
{{ profile.env_setup }}
# --- Resources this job requested (read back by naa-param) -------------------
export NAA_PARAM_NPROC={{ req.cpus }}
export NAA_PARAM_MEM_MB={{ req.mem_mb }}

set -o pipefail

echo "=================================================================="
echo " naa_param — assembly of {{ tasks|length }} task(s) — profile {{ profile.name }}"
echo " Job : {{ sched.job_id }} on $(hostname) — started $(date)"
echo "=================================================================="

# Abort on the first failure: a residue must never be integrated on top of a
# force field that was not built. `set -e` is deliberately not used — it would
# leave the job without this diagnostic.
run_task() {
    local label="$1"
    shift
    local rc=0
    echo ""
    echo "------------------------------------------------------------------"
    echo " $label"
    echo "------------------------------------------------------------------"
    "$@" || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "" >&2
        echo "ERROR: $label failed (exit $rc)." >&2
        echo "       Remaining tasks were skipped so nothing is built on a" >&2
        echo "       partially integrated force field." >&2
        echo "       Fix the cause, then resubmit this script on its own:" >&2
        echo "         {{ sched.submit }} {{ script_name }}" >&2
        echo "       Tasks that already completed are skipped automatically." >&2
        exit "$rc"
    fi
}

{% for task in tasks %}
run_task "[{{ loop.index }}/{{ tasks|length }}] {{ task.label }}" {{ task.command }}
{% endfor %}

echo ""
echo "=================================================================="
echo " Assembly complete — $(date)"
echo " Outputs in: {{ final_output_dir }}"
echo "=================================================================="
